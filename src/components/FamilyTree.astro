---
import { Image } from "astro:assets";
import { accents, getDog, pedigree } from "../data/dogs";
import { listPhotos } from "../lib/photos";

const branches = pedigree.branches;
---

<div>
  <div class="mx-auto w-full max-w-5xl">
    <article class="mx-auto max-w-sm overflow-hidden rounded-3xl bg-white text-center shadow-sm ring-1 ring-blue-100">
      <Image
        src={pedigree.grandparentsPhoto}
        alt="Alfredo Llanos e Ingrid Frelijj juntos"
        widths={[480, 800]}
        sizes="(min-width: 640px) 24rem, 90vw"
        class="aspect-[4/3] w-full object-cover object-[center_22%]"
      />
      <div class="px-5 py-4">
        <p class="text-xs font-bold tracking-wide text-stone-500 uppercase">Generación anterior</p>
        <h3 class="mt-1 font-display text-2xl text-blue-950">{pedigree.grandparentsLabel}</h3>
        <p class="mt-1 font-semibold text-stone-950">{pedigree.grandparentsName}</p>
      </div>
    </article>

    <p class="mx-auto mt-4 max-w-md text-center text-sm text-pretty text-stone-500">
      Esos abuelos tuvieron dos hijas, Romina y Martha. Cada una formó una pareja de perros.
    </p>

    <div class="mx-auto mt-2 h-6 w-px bg-blue-200 md:hidden" aria-hidden="true"></div>
    <div class="relative mt-2 hidden h-8 md:block" aria-hidden="true">
      <div class="absolute top-0 left-1/2 h-3 w-px -translate-x-1/2 bg-blue-200"></div>
      <div class="absolute top-3 right-1/4 left-1/4 h-px bg-blue-200"></div>
      <div class="absolute top-3 left-1/4 h-5 w-px -translate-x-1/2 bg-blue-200"></div>
      <div class="absolute top-3 left-3/4 h-5 w-px -translate-x-1/2 bg-blue-200"></div>
    </div>

    <div class="relative flex flex-col gap-6 md:grid md:grid-cols-2 md:items-start md:gap-x-16">
      {
        branches.map((branch, index) => (
          <>
            {index === 1 && (
              <p class="z-10 justify-self-center self-center rounded-full bg-blue-700 px-4 py-1.5 text-sm font-bold text-white shadow-md shadow-blue-900/20 md:absolute md:top-28 md:left-1/2 md:-translate-x-1/2">
                Primos
              </p>
            )}
            <article
              class:list={[
                "rounded-3xl bg-sky-50/80 p-4 ring-1 ring-blue-100 sm:p-5",
                index === 1 && "md:col-start-2 md:row-start-1",
              ]}
            >
              <div class="text-center">
                <span class="mx-auto block size-20 overflow-hidden rounded-full ring-2 ring-blue-200">
                  <Image
                    src={branch.photo}
                    alt=""
                    width={320}
                    height={320}
                    class="size-full object-cover"
                    style={`object-position: ${branch.photoPosition}; transform: scale(2.1); transform-origin: ${branch.photoPosition};`}
                  />
                </span>
                <p class="mt-3 text-sm font-bold text-stone-800">{branch.parentsLabel}</p>
                <p class="mt-1 font-display text-xl text-stone-950">{branch.parentsName}</p>
              </div>

              <p class="mt-4 text-center text-xs font-bold tracking-wide text-blue-700 uppercase">Hermanos</p>
              <div class="relative h-7" aria-hidden="true">
                <div class="absolute top-0 left-1/2 h-2.5 w-px -translate-x-1/2 bg-blue-200"></div>
                <div class="absolute top-2.5 right-1/4 left-1/4 h-px bg-blue-200"></div>
                <div class="absolute top-2.5 left-1/4 h-4 w-px -translate-x-1/2 bg-blue-200"></div>
                <div class="absolute top-2.5 left-3/4 h-4 w-px -translate-x-1/2 bg-blue-200"></div>
              </div>

              <ul class="grid grid-cols-2 gap-3">
                {branch.slugs.map((slug) => {
                  const dog = getDog(slug);
                  const accent = accents[dog.slug];
                  const cover = listPhotos(dog.slug)[0];
                  return (
                    <li>
                      <a
                        href={`/perros/${dog.slug}`}
                        class="flex flex-col items-center rounded-2xl bg-white px-2 py-3 text-center shadow-sm ring-1 ring-blue-100 transition hover:-translate-y-0.5 hover:ring-blue-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
                      >
                        {cover ? (
                          <Image
                            src={cover.image}
                            alt=""
                            width={96}
                            height={96}
                            class:list={["size-16 rounded-full object-cover ring-2", accent.ring]}
                          />
                        ) : (
                          <span
                            class:list={[
                              "grid size-16 place-items-center rounded-full font-display text-2xl ring-2",
                              accent.chip,
                              accent.ring,
                            ]}
                          >
                            {dog.name.slice(0, 1)}
                          </span>
                        )}
                        <span class="mt-2 font-bold text-blue-950">{dog.name}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </article>
          </>
        ))
      }
    </div>
  </div>
</div>
