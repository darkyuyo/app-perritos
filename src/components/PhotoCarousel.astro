---
import { Image } from "astro:assets";
import type { GalleryPhoto } from "../lib/photos";

interface Props {
  photos: GalleryPhoto[];
  interval?: number;
}

const { photos, interval = 3000 } = Astro.props;
---

<div
  class="pack-carousel group relative h-[26rem] overflow-hidden rounded-[2rem] bg-gradient-to-br from-blue-800 via-blue-600 to-sky-400 shadow-xl shadow-blue-900/20 sm:h-[32rem]"
  data-interval={interval}
>
  {
    photos.length === 0 ? (
      <div class="grid h-full place-items-center px-6 text-center text-blue-50">
        <p>Todavía no hay fotos de todos juntos. Guárdalas en src/assets/fotos/todos/.</p>
      </div>
    ) : (
      photos.map((photo, index) => (
        <Image
          src={photo.image}
          alt={index === 0 ? "La manada junta" : ""}
          widths={[640, 1200, 1600]}
          sizes="(min-width: 1152px) 1152px, 100vw"
          data-slide
          aria-hidden={index === 0 ? "false" : "true"}
          class:list={[
            "pack-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-700",
            index === 0 ? "opacity-100" : "opacity-0",
          ]}
        />
      ))
    )
  }

  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-blue-950/80 via-blue-950/15 to-transparent"></div>

  <div class="absolute inset-x-0 bottom-0 flex flex-col gap-4 p-5 sm:p-8">
    <div>
      <h1 class="font-display text-3xl text-white sm:text-5xl">La familia perruna</h1>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href="#manada"
          class="inline-flex justify-center rounded-full bg-white px-5 py-3 text-sm font-bold text-blue-800 hover:bg-blue-50"
        >
          Ver a los babys
        </a>
        <a
          href="#arbol"
          class="inline-flex justify-center rounded-full bg-blue-950/55 px-5 py-3 text-sm font-bold text-white ring-1 ring-white/70 backdrop-blur-sm hover:bg-blue-950/75"
        >
          Ver el árbol
        </a>
      </div>
      {
        photos.length > 1 && (
          <div class="flex flex-wrap items-center gap-2 sm:justify-end" role="tablist" aria-label="Fotos de la manada">
            {photos.map((_, index) => (
              <button
                type="button"
                data-dot={index}
                aria-label={`Mostrar foto ${index + 1}`}
                aria-current={index === 0 ? "true" : "false"}
                class="size-2.5 rounded-full bg-white/45 transition aria-[current=true]:scale-125 aria-[current=true]:bg-white"
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const carousel of document.querySelectorAll(".pack-carousel")) {
    if (!(carousel instanceof HTMLElement)) continue;

    const slides = [...carousel.querySelectorAll("[data-slide]")].filter(
      (slide) => slide instanceof HTMLElement,
    );
    const dots = [...carousel.querySelectorAll("[data-dot]")].filter(
      (dot) => dot instanceof HTMLButtonElement,
    );
    if (slides.length < 2) continue;

    let index = 0;
    let timer = 0;
    const interval = Number(carousel.dataset.interval) || 3000;

    const show = (next: number) => {
      const previous = slides[index];
      const previousDot = dots[index];
      if (!(previous instanceof HTMLElement) || !(previousDot instanceof HTMLButtonElement)) return;

      previous.classList.replace("opacity-100", "opacity-0");
      previous.setAttribute("aria-hidden", "true");
      previousDot.setAttribute("aria-current", "false");

      index = (next + slides.length) % slides.length;

      const current = slides[index];
      const currentDot = dots[index];
      if (!(current instanceof HTMLElement) || !(currentDot instanceof HTMLButtonElement)) return;

      current.classList.replace("opacity-0", "opacity-100");
      current.setAttribute("aria-hidden", "false");
      current.setAttribute("alt", "La manada junta");
      currentDot.setAttribute("aria-current", "true");
    };

    const stop = () => window.clearInterval(timer);

    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => show(index + 1), interval);
    };

    for (const dot of dots) {
      if (!(dot instanceof HTMLButtonElement)) continue;
      dot.addEventListener("click", () => {
        const target = Number(dot.dataset.dot);
        if (target === index) return;
        show(target);
        start();
      });
    }

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }
</script>
