---
import { Image } from "astro:assets";
import type { GalleryPhoto } from "../lib/photos";

interface Props {
  id?: string;
  title: string;
  subject: string;
  folder: string;
  photos: GalleryPhoto[];
}

const { id, title, subject, folder, photos } = Astro.props;
const folderPath = `src/assets/fotos/${folder}/`;
---

<section id={id} class="photo-gallery">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="font-display text-3xl text-stone-950 sm:text-4xl">{title}</h2>
      {
        photos.length > 0 && (
          <p class="mt-1 text-sm text-stone-500">
            {photos.length === 1 ? "1 foto" : `${photos.length} fotos`}
          </p>
        )
      }
    </div>
    <p class="text-sm text-stone-500">
      Agrega fotos en <code class="rounded bg-white px-1.5 py-0.5 break-all text-stone-700 ring-1 ring-stone-200">{folderPath}</code>
    </p>
  </div>

  {
    photos.length === 0 ? (
      <div class="mt-5 rounded-3xl border border-dashed border-stone-300 bg-white/70 px-6 py-12 text-center">
        <p class="font-display text-2xl text-stone-800">Todavía no hay fotos</p>
        <p class="mx-auto mt-2 max-w-md text-pretty text-stone-600">
          Guarda jpg, png o webp en esa carpeta. Si una se llama <span class="font-semibold">cover.jpg</span>, sale primera.
        </p>
      </div>
    ) : (
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {photos.map((photo, index) => {
          const alt = `Foto ${index + 1} de ${subject}`;
          return (
            <li>
              <button
                type="button"
                aria-label={alt}
                data-full={photo.src}
                data-alt={alt}
                class="group relative block aspect-square w-full cursor-zoom-in overflow-hidden rounded-2xl bg-stone-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700"
              >
                <Image
                  src={photo.image}
                  alt={alt}
                  widths={[240, 480, 800]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                  class="absolute inset-0 h-full w-full object-cover transition duration-300 motion-safe:group-hover:scale-105"
                />
              </button>
            </li>
          );
        })}
      </ul>
    )
  }

  {
    photos.length > 0 && (
      <dialog
        aria-label="Foto ampliada"
        class="m-auto w-[min(100vw-1.5rem,960px)] max-h-[92vh] rounded-2xl bg-stone-950 p-3 text-stone-50 backdrop:bg-stone-950/75"
      >
        <form method="dialog" class="mb-3 flex items-center justify-between gap-3">
          <p class="gallery-caption truncate text-sm text-stone-300"></p>
          <button class="shrink-0 rounded-full bg-white px-4 py-2 text-sm font-semibold text-stone-950">
            Cerrar
          </button>
        </form>
        <img class="gallery-full mx-auto max-h-[75vh] w-full object-contain" alt="" />
      </dialog>
    )
  }
</section>

<script>
  for (const gallery of document.querySelectorAll(".photo-gallery")) {
    const dialog = gallery.querySelector("dialog");
    const full = gallery.querySelector("img.gallery-full");
    if (!(dialog instanceof HTMLDialogElement) || !(full instanceof HTMLImageElement)) continue;

    for (const button of gallery.querySelectorAll("button[data-full]")) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.addEventListener("click", () => {
        full.src = button.dataset.full ?? "";
        full.alt = button.dataset.alt ?? "";
        const caption = gallery.querySelector(".gallery-caption");
        if (caption) caption.textContent = button.dataset.alt ?? "";
        dialog.showModal();
      });
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
