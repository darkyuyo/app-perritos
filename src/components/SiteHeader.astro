---
import { dogs } from "../data/dogs";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/familia", label: "Familia" },
  ...dogs.map((dog) => ({ href: `/perros/${dog.slug}`, label: dog.name })),
];

function isActive(href: string): boolean {
  return path === href;
}
---

<header class="sticky top-0 z-30 border-b border-blue-100/80 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href="/" class="font-display text-2xl tracking-tight text-blue-950">Perritos</a>

    <nav class="hidden md:block" aria-label="Principal">
      <ul class="flex flex-wrap justify-end gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-full px-3 py-1.5 text-sm font-semibold",
                  isActive(link.href) ? "bg-blue-700 text-white" : "text-slate-600 hover:bg-blue-50 hover:text-blue-800",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="no-marker cursor-pointer rounded-full bg-blue-700 px-4 py-2 text-sm font-semibold text-white"
      >
        Menú
      </summary>
      <nav
        class="absolute right-0 z-40 mt-2 w-56 rounded-2xl bg-white p-2 shadow-xl ring-1 ring-blue-100"
        aria-label="Principal"
      >
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "block rounded-xl px-3 py-2.5 text-sm font-semibold",
                    isActive(link.href) ? "bg-blue-700 text-white" : "text-slate-700 hover:bg-blue-50",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
