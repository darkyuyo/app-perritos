---
import { Image } from "astro:assets";
import { accents, packLine, type Dog } from "../data/dogs";
import { listPhotos } from "../lib/photos";

interface Props {
  dog: Dog;
}

const { dog } = Astro.props;
const accent = accents[dog.slug];
const cover = listPhotos(dog.slug)[0];
---

<a
  href={`/perros/${dog.slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-md shadow-blue-950/5 ring-1 ring-blue-100 transition hover:shadow-xl hover:ring-blue-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 motion-safe:hover:-translate-y-1"
>
  <div class:list={["relative aspect-[4/3] overflow-hidden", !cover && accent.wash]}>
    {
      cover ? (
        <Image
          src={cover.image}
          alt={`Foto de ${dog.name}`}
          widths={[400, 800]}
          sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw"
          class="absolute inset-0 h-full w-full object-cover transition duration-300 motion-safe:group-hover:scale-105"
        />
      ) : (
        <div class:list={["grid h-full place-items-center font-display text-6xl", accent.ink]}>
          {dog.name.slice(0, 1)}
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex items-center gap-2">
      <span class:list={["size-2.5 shrink-0 rounded-full", accent.dot]} aria-hidden="true"></span>
      <h3 class="font-display text-2xl text-blue-950">{dog.name}</h3>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-pretty text-stone-600">{packLine(dog)}</p>
    <p class="mt-4 text-sm font-bold text-blue-700">Ver ficha</p>
  </div>
</a>
