---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import DogCard from "../components/DogCard.astro";
import FamilyTree from "../components/FamilyTree.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { accents, dogs, pending } from "../data/dogs";
import { listPhotos } from "../lib/photos";

const dates = dogs.map((dog) => ({
  dog,
  birthdate: dog.birthdate,
  arrived: dog.arrived,
}));
---

<BaseLayout
  title="Mis perros"
  description="Fichas, fotos y árbol familiar de Maddy, Blacky, Simba y Charlotte."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
    <section class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-blue-800 via-blue-600 to-sky-400 px-6 py-10 text-white shadow-xl shadow-blue-900/20 sm:px-10 sm:py-14">
      <div class="pointer-events-none absolute -top-20 -right-16 size-64 rounded-full bg-white/10" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/3 size-56 rounded-full bg-sky-200/20" aria-hidden="true"></div>
      <p class="relative text-sm font-bold tracking-[0.18em] text-sky-100 uppercase">Cuatro perros, una manada</p>
      <h1 class="relative mt-3 max-w-3xl font-display text-4xl leading-tight text-balance text-white sm:text-6xl">
        Maddy, Blacky, Simba y Charlotte
      </h1>
      <p class="relative mt-4 max-w-xl text-lg leading-relaxed text-pretty text-blue-50">
        Sus fotos, su familia y una ficha para cada uno. Los textos siguen en blanco para ir completándolos.
      </p>
      <ul class="relative mt-8 flex -space-x-3" aria-hidden="true">
        {
          dogs.map((dog) => {
            const cover = listPhotos(dog.slug)[0];
            return (
              <li>
                {cover ? (
                  <Image
                    src={cover.image}
                    alt=""
                    width={160}
                    height={160}
                    class="size-16 rounded-full object-cover ring-4 ring-white sm:size-20"
                  />
                ) : (
                  <span
                    class:list={[
                      "grid size-16 place-items-center rounded-full font-display text-xl ring-4 ring-white sm:size-20",
                      accents[dog.slug].chip,
                    ]}
                  >
                    {dog.name.slice(0, 1)}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
      <div class="relative mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#manada"
          class="inline-flex justify-center rounded-full bg-white px-5 py-3 text-sm font-bold text-blue-800 hover:bg-blue-50"
        >
          Ver a los cuatro
        </a>
        <a
          href="#arbol"
          class="inline-flex justify-center rounded-full bg-white/15 px-5 py-3 text-sm font-bold text-white ring-1 ring-white/40 hover:bg-white/25"
        >
          Ver el árbol
        </a>
      </div>
    </section>

    <section id="manada" class="mt-14">
      <p class="text-sm font-bold tracking-[0.16em] text-blue-700 uppercase">Los cuatro</p>
      <h2 class="mt-1 font-display text-3xl text-blue-950 sm:text-4xl">La manada</h2>
      <p class="mt-2 max-w-2xl text-pretty text-slate-600">
        Maddy y Blacky son hermanos. Charlotte y Simba son hermanos. Las dos parejas son primas.
      </p>
      <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {
          dogs.map((dog) => (
            <li class="h-full">
              <DogCard dog={dog} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="arbol" class="mt-16">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-bold tracking-[0.16em] text-blue-700 uppercase">Parentesco</p>
          <h2 class="mt-1 font-display text-3xl text-blue-950 sm:text-4xl">Árbol familiar</h2>
        </div>
        <a href="/familia" class="text-sm font-bold text-blue-700 hover:text-blue-900">Cómo se llevan</a>
      </div>
      <div class="mt-6 rounded-[2rem] bg-white/80 p-4 shadow-sm ring-1 ring-blue-100 sm:p-8">
        <FamilyTree />
      </div>
    </section>

    <div class="mt-16">
      <PhotoGallery
        id="fotos"
        title="Todos juntos"
        subject="la manada"
        folder="todos"
        photos={listPhotos("todos")}
      />
    </div>

    <section id="fechas" class="mt-16">
      <p class="text-sm font-bold tracking-[0.16em] text-blue-700 uppercase">Calendario</p>
      <h2 class="mt-1 font-display text-3xl text-blue-950 sm:text-4xl">Fechas</h2>
      <p class="mt-2 max-w-2xl text-pretty text-slate-600">
        Cumpleaños y el día en que cada uno llegó a casa. Todavía están en blanco.
      </p>
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          dates.map(({ dog, birthdate, arrived }) => (
            <li class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-blue-100">
              <div class:list={["h-1.5", accents[dog.slug].dot]} aria-hidden="true"></div>
              <div class="p-4 sm:p-5">
              <div class="flex items-center gap-2">
                <span class:list={["size-2.5 rounded-full", accents[dog.slug].dot]} aria-hidden="true" />
                <h3 class="font-display text-2xl text-blue-950">
                  <a href={`/perros/${dog.slug}`} class="hover:text-blue-700">
                    {dog.name}
                  </a>
                </h3>
              </div>
              <dl class="mt-3 grid grid-cols-1 gap-2 text-sm min-[420px]:grid-cols-2">
                <div>
                  <dt class="text-stone-500">Cumpleaños</dt>
                  <dd
                    class:list={[
                      birthdate === pending
                        ? "font-normal text-stone-400 italic"
                        : "font-semibold text-stone-900",
                    ]}
                  >
                    {birthdate}
                  </dd>
                </div>
                <div>
                  <dt class="text-stone-500">Llegó a casa</dt>
                  <dd
                    class:list={[
                      arrived === pending
                        ? "font-normal text-stone-400 italic"
                        : "font-semibold text-stone-900",
                    ]}
                  >
                    {arrived}
                  </dd>
                </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
